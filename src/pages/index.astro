---
import '../styles/site.css';
import Countdown from '../components/Countdown.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>LastLap. One more.</title>
    <meta name="description" content="LastLap is a last-one-standing race in Thakur Village, Mumbai. 6.706 km every hour, up to 24 loops and 100 miles. 2 January 2027, tentative." />
    <meta name="theme-color" content="#070304" />
    <meta property="og:title" content="LastLap. One more." />
    <meta property="og:description" content="6.706 km every hour, up to 24 loops and 100 miles. Thakur Village, Mumbai. Not for everyone." />
    <meta property="og:image" content="/media/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.png" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/anek-latin-latin-standard-normal.woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement, ok = false;
        d.classList.add('js');
        try { ok = !!document.createElement('canvas').getContext('webgl2'); } catch (e) {}
        if (ok && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('film', 'locked');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#register">Skip to registration</a>
    <canvas id="film" role="img" aria-label="A continuous film of a night race: a runner in fog, a route through Mumbai, and 24 hours passing until one runner remains."></canvas>

    <div class="gate film-only" id="gate">
      <div class="gate-in">
        <img src="/brand/lastlap-logo-small.webp" alt="LastLap" width="280" height="280" />
        <p class="gate-line">Thakur Village, Mumbai. 2 January 2027, tentative.</p>
        <div class="gate-go">
          <button id="enterIntro" type="button" disabled>Event intro<i id="gateBar" aria-hidden="true"></i></button>
          <button id="enterRegister" type="button">Register now<i aria-hidden="true"></i></button>
        </div>
        <button class="sound gate-sound" id="gateSound" type="button" aria-pressed="false"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><span>Sound</span></button>
      </div>
    </div>

    <header class="bar">
      <a class="bar-logo" href="#start"><img src="/brand/lastlap-logo-small.webp" alt="LastLap" width="280" height="280" /></a>
      <div class="bar-right">
        <button class="sound film-only" id="sound" type="button" aria-pressed="false"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><span>Sound</span></button>
        <a class="bar-cta" href="#register">Register</a>
      </div>
    </header>

    <nav class="rail film-only" aria-label="Chapters">
      <span class="rail-line"><span id="railFill"></span></span>
      <a href="#start"><span>Start</span></a>
      <a href="#loop"><span>The loop</span></a>
      <a href="#night"><span>The night</span></a>
      <a href="#last"><span>Last light</span></a>
      <a href="#register"><span>Register</span></a>
    </nav>

    <div class="hud film-only" id="hud" aria-hidden="true">
      <svg viewBox="396 270 790 620"><path id="hudPath" /><circle id="hudDot" r="30" /></svg>
      <dl>
        <div><dt>LOOP</dt><dd id="hudLoop">01</dd></div>
        <div><dt>KM</dt><dd><span id="hudKm">000</span><i class="pt"></i><span id="hudKmD">0</span></dd></div>
        <div><dt>TIME</dt><dd><span id="hudH">00</span><i class="colon"></i><span id="hudM">00</span><i class="colon"></i><span id="hudS">00</span></dd></div>
      </dl>
    </div>

    <main>
      <div class="reel" id="reel">
        <div class="stage" id="stage">
          <section class="beat beat-open" data-shot="open" id="start">
            <picture><source media="(max-width: 760px)" srcset="/media/open-m.webp" width="1080" height="1919" /><img src="/media/open.webp" alt="A figure in a glowing red headlamp standing alone in blue fog" width="2560" height="1507" loading="lazy" /></picture>
            <div class="copy" data-first>
              <p class="hi" lang="hi"><span class="ln"><span>एक और</span></span></p>
              <h1 class="mega"><span class="ln"><span>One more.</span></span></h1>
              <p class="sub"><span class="ln"><span>6.706 km. Every hour. For up to 24 hours.</span></span></p>
            </div>
            <Countdown class="next" id="next" />
            <div class="live-now" id="liveNow" role="status" aria-label="Race day, live">
              <p class="live-tag"><i aria-hidden="true"></i>LIVE</p>
              <p class="live-read"><span>LOOP <b id="liveLoop">00</b></span><span><b id="liveLeft">0</b> OF <b id="liveTotal">0</b> STILL RUNNING</span></p>
            </div>
            <p class="cue film-only" id="cue" aria-hidden="true"><i></i>Scroll</p>
          </section>

          <section class="beat" data-shot="loop" id="loop">
            <picture><source media="(max-width: 760px)" srcset="/media/plate-m.webp" /><img src="/media/plate-route.webp" alt="Aerial view of Mumbai residential towers at night with a string of headlamps along the road" width="1920" height="1097" loading="lazy" /></picture>
            <div class="copy" data-a="0.05" data-b="0.32"><p class="big"><span class="ln"><span>6.706 km.</span></span><span class="ln"><span>One hour.</span></span></p></div>
            <div class="copy" data-a="0.36" data-b="0.62"><p class="big"><span class="ln"><span>8:57 per km.</span></span><span class="ln"><span>Sounds easy.</span></span></p></div>
            <div class="copy" data-a="0.66" data-b="0.96"><p class="big"><span class="ln"><span>Back before the bell.</span></span><span class="ln"><span>Or you're out.</span></span></p></div>
            <p class="route-note" id="routeNote">Illustrative route, not the course</p>
          </section>

          <section class="beat" data-shot="again">
            <picture><source media="(max-width: 760px)" srcset="/media/again-m.webp" /><img src="/media/again.webp" alt="Long exposure at Chhatrapati Shivaji Terminus in Mumbai: a figure stands still in the road while red traffic trails pass through them" width="2560" height="2184" loading="lazy" /></picture>
            <div class="copy stack" id="stack">
              <p class="row r1"><span class="ln"><span>Again.</span></span><span class="tag">LOOP 02</span></p>
              <p class="row r2"><span class="ln"><span>And again.</span></span><span class="tag">LOOP 03</span></p>
              <p class="row r3"><span class="ln"><span>And again.</span></span><span class="tag">LOOP 04</span></p>
              <p class="sub"><span class="ln"><span>Up to 24 times, if you last.</span></span></p>
            </div>
          </section>

          <section class="beat" data-shot="field" id="night">
            <picture><source media="(max-width: 760px)" srcset="/media/field-m.webp" /><img src="/media/field.webp" alt="Aerial view of a river of runners on a tree-lined road at night" width="2560" height="1629" loading="lazy" /></picture>
            <div class="copy"><p class="hr"><span class="ln"><span>HOUR 04</span></span></p><p class="big"><span class="ln"><span>Everyone still believes.</span></span></p></div>
          </section>

          <section class="beat" data-shot="run">
            <picture><source media="(max-width: 760px)" srcset="/media/run-m.webp" /><img src="/media/run.webp" alt="Three runners seen from behind on a wet waterfront path at night" width="1920" height="1080" loading="lazy" /></picture>
            <div class="copy"><p class="hr"><span class="ln"><span>HOUR 06</span></span></p><p class="big"><span class="ln"><span>Still easy. Still talking.</span></span></p></div>
          </section>

          <section class="beat" data-shot="shore">
            <picture><source media="(max-width: 760px)" srcset="/media/shore-m.webp" /><img src="/media/shore.webp" alt="Silhouettes of runners crossing in front of a lit city across the water" width="1920" height="1080" loading="lazy" /></picture>
            <div class="copy"><p class="hr"><span class="ln"><span>HOUR 08</span></span></p><p class="big"><span class="ln"><span>The city goes to sleep.</span></span></p></div>
          </section>

          <section class="beat" data-shot="train">
            <picture><source media="(max-width: 760px)" srcset="/media/train-m.webp" /><img src="/media/train.webp" alt="A train streaking past a red-lit platform at night under a red LED clock, with one person waiting" width="2560" height="1552" loading="lazy" /></picture>
            <div class="copy"><p class="hr"><span class="ln"><span>HOUR 10</span></span></p><p class="big"><span class="ln"><span>The last local leaves.</span></span></p></div>
          </section>

          <section class="beat" data-shot="lone">
            <picture><source media="(max-width: 760px)" srcset="/media/lone-m.webp" /><img src="/media/lone.webp" alt="A lone runner in silhouette against a lit colonnade, reflected in wet ground" width="2560" height="1613" loading="lazy" /></picture>
            <div class="copy"><p class="hr"><span class="ln"><span>HOUR 13</span></span></p><p class="big"><span class="ln"><span>No one is watching.</span></span></p></div>
          </section>

          <section class="beat" data-shot="dawn">
            <picture><source media="(max-width: 760px)" srcset="/media/dawn-m.webp" /><img src="/media/dawn.webp" alt="Mumbai towers at first light" width="1920" height="1080" loading="lazy" /></picture>
            <div class="copy"><p class="hr"><span class="ln"><span>HOUR 15</span></span></p><p class="big"><span class="ln"><span>100 km. Nine loops to go.</span></span></p></div>
          </section>

          <section class="beat" data-shot="rain">
            <picture><source media="(max-width: 760px)" srcset="/media/rain-m.webp" /><img src="/media/rain.webp" alt="Rain falling through a single streetlight in the dark" width="1920" height="1080" loading="lazy" /></picture>
            <div class="bigclock film-only" id="bigClock" aria-hidden="true"><svg id="bigDigits" viewBox="0 0 802 170"></svg></div>
            <div class="copy"><p class="hr"><span class="ln"><span>HOUR 23</span></span></p><p class="big"><span class="ln"><span>One bell left.</span></span></p></div>
          </section>

          <section class="beat" data-shot="last" id="last">
            <picture><source media="(max-width: 760px)" srcset="/media/last-m.webp" /><img src="/media/last.webp" alt="One runner in full stride, in silhouette against a low red sun" width="2560" height="1462" loading="lazy" /></picture>
            <div class="copy"><p class="hr"><span class="ln"><span>HOUR 24</span></span></p><p class="mega"><span class="ln"><span>Last one</span></span><span class="ln"><span>standing.</span></span></p></div>
          </section>

          <section class="beat" data-shot="flares">
            <picture><source media="(max-width: 760px)" srcset="/media/flares-m.webp" /><img src="/media/flares.webp" alt="" width="2560" height="1434" loading="lazy" /></picture>
            <div class="copy copy-mid" data-final>
              <p class="colossal" lang="hi"><span class="ln"><span>एक और</span></span></p>
              <p class="sub"><span class="ln"><span>6.706 km. Every hour, on the hour. 24 loops at most.</span></span></p>
            </div>
          </section>
        </div>
      </div>

      <section class="register" id="register">
        <div class="entry" id="entry">
          <div class="entry-art" id="entryArt">
          <picture class="entry-bg"><source media="(max-aspect-ratio: 9/10)" srcset="/media/last-m.webp" width="1080" height="1920" /><img src="/media/last.webp" alt="A runner in full stride in front of a low red sun" width="2560" height="1462" loading="lazy" /></picture>
          <p class="giant reveal" id="giant" aria-hidden="true"><span class="ln"><span>Not for</span></span><span class="ln"><span>everyone.</span></span></p>
          <picture class="entry-fg"><source media="(max-aspect-ratio: 9/10)" srcset="/media/last-m-fg.webp" width="1080" height="1920" /><img src="/media/last-fg.webp" alt="" width="2560" height="1462" loading="lazy" /></picture>
          <i class="entry-shade" aria-hidden="true"></i>
          </div>

          <div class="entry-foot">
            <h2 class="sr-only">Not for everyone.</h2>
            <p class="lede reveal"><span class="ln"><span>For the elite, and for anyone crazy enough to find out where they stop.</span></span><span class="ln"><span>Everyone else hears about it.</span></span></p>
            <Countdown class="entry-count" />
            <form id="list" novalidate>
              <div class="field"><label for="name">Name on your bib</label><input id="name" name="name" type="text" autocomplete="name" maxlength="22" placeholder="Your name" /></div>
              <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="listMsg" /></div>
              <div class="field" id="inviteField" hidden><label for="invite">Invite code</label><input id="invite" name="invite" type="text" autocomplete="off" autocapitalize="characters" maxlength="8" placeholder="From a runner" /></div>
              <input class="hp" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button class="go" type="submit">Put my name down</button>
              <p id="listMsg" class="msg" role="status"></p>
              <p class="field-state" id="fieldState" hidden></p>
              <button class="keep" id="savePoster" type="button" hidden>Save my poster</button>
            </form>
            <div class="done" id="done" hidden>
              <p class="done-bib"><span id="doneLabel">YOU'RE IN</span><b id="doneBib">BIB 000</b></p>
              <p class="done-line" id="doneLine"></p>
              <div class="invites" id="invites" hidden>
                <p>Two invites. Give them to people crazy enough.</p>
                <ul id="inviteList"></ul>
              </div>
              <div class="done-act"><button class="go" id="donePoster" type="button">Save my poster</button><a class="act" href="#prove">Now prove it</a></div>
            </div>
            <p class="closed">Registration is closed. The race is on.</p>
          </div>
        </div>

        <section class="prove" id="prove">
          <h2 class="prove-q reveal"><span class="ln"><span>Prove it.</span></span></h2>
          <form class="prove-form" id="proveForm" novalidate>
            <label for="feat">Your biggest running achievement</label>
            <div class="prove-row"><input id="feat" name="feat" type="text" maxlength="140" autocomplete="off" placeholder="A 10K in 52 minutes. A marathon. Nothing yet." /><button class="go" type="submit">Judge me</button></div>
          </form>
          <div class="verdict" id="verdict" aria-live="polite" hidden>
            <p class="jab" id="jab"></p>
            <p class="truth" id="truth"></p>
            <p class="dare-line"><span>I dare you to finish</span><b id="dareN">1</b><span id="dareUnit">loops.</span></p>
            <p class="dare-math" id="dareMath"></p>
            <div class="dare-act"><button class="go" id="takeDare" type="button">Accept the dare</button><button class="act" id="againDare" type="button">Try something else</button></div>
          </div>
        </section>

        <section class="field-live" id="field" aria-labelledby="fieldTitle">
          <h2 id="fieldTitle">The field</h2>
          <p class="field-line" id="fieldLine"></p>
          <ol class="field-list" id="fieldList"></ol>
        </section>

        <div class="after">
          <dl class="facts">
            <div><dt>Format</dt><dd>6.706 km every hour. 24 loops at most, which is 100 miles.</dd></div>
            <div><dt>Where</dt><dd>Thakur Village, Mumbai</dd></div>
            <div><dt>When</dt><dd>2 January 2027, tentative</dd></div>
            <div><dt>Places</dt><dd>Limited. Your name on the list isn't an entry or a payment.</dd></div>
          </dl>

          <div class="contact" id="contact">
            <h2>Contact us for more info</h2>
            <ul>
              <li><a href="tel:+919372031465"><span>Jeevesh Bodhani</span><b>+91 93720 31465</b></a></li>
              <li><a href="tel:+917208515979"><span>Om Tekriwal</span><b>+91 72085 15979</b></a></li>
            </ul>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <p>LastLap is an independent event, not affiliated with any other race or series. Concept preview: imagery is licensed stock and doesn't show LastLap, and the route is illustrative.</p>
    </footer>
    <script src="../scripts/main.js"></script>
  </body>
</html>
