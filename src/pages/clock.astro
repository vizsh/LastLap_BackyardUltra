---
import '../styles/site.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#000000" />
    <title>LastLap race clock</title>
    <link rel="icon" href="/favicon.png" />
    <style is:global>
      html, body { height: 100%; background: #000; overflow: hidden; }
      .board { position: fixed; inset: 0; display: grid; place-items: center; padding: 3vmin; animation: rise 1.1s var(--ease) both; }
      @keyframes rise { from { opacity: 0; transform: scale(.985); } }
      #digits { width: min(96vw, 200vh); height: auto; max-height: 92vh; overflow: visible; filter: drop-shadow(0 0 .9vmin #ff2a1a99); }
      .seg { fill: #1c0605; transition: fill .16s linear; }
      .seg.on { fill: #ff2f1f; }
      .dot { fill: #ff2f1f; transition: opacity .35s ease; }
      .paused .dot { opacity: .35; }
      .board.hour { animation: hour 1.8s var(--ease); }
      @keyframes hour { 0% { filter: brightness(1.9); } 100% { filter: brightness(1); } }
      .panel { position: fixed; left: 50%; bottom: max(18px, env(safe-area-inset-bottom)); z-index: 2; translate: -50% 0; width: min(94vw, 900px); display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 20px; padding: 10px 18px; background: #0f0506e6; border: 1px solid #f1f3f51f; border-radius: 6px; transition: opacity .5s var(--ease), translate .5s var(--ease); }
      .idle .panel { opacity: 0; translate: -50% 14px; pointer-events: none; }
      .idle { cursor: none; }
      .panel button { min-height: 44px; padding: 0 6px; font-size: 1.0625rem; font-weight: 500; color: var(--headlamp); transition: color .2s; }
      .panel button:hover { color: var(--flare); }
      .panel #run { color: var(--flare); font-weight: 700; min-width: 4.2em; }
      .set { display: flex; align-items: center; gap: 4px; }
      .set label { margin: 0 6px 0 0; color: var(--dusk); font-size: .9375rem; }
      .set input { flex: none; width: 2.5em; min-height: 40px; padding: 0; text-align: center; font-size: 1.0625rem; border-bottom: 1px solid #f1f3f540; font-variant-numeric: tabular-nums; }
      .set input:focus { border-bottom-color: var(--flare); }
      @media (prefers-reduced-motion: reduce) { .board, .board.hour { animation: none; } .seg { transition: none; } }
    </style>
  </head>
  <body>
    <div class="board" id="board">
      <svg id="digits" viewBox="0 0 802 170" role="timer" aria-label="Race clock"></svg>
    </div>
    <div class="panel" id="panel">
      <button id="run" type="button">Start</button>
      <button id="reset" type="button">Reset</button>
      <button type="button" data-preset="86400">24:00:00</button>
      <button type="button" data-preset="165600">46:00:00</button>
      <form class="set" id="set">
        <label for="h">Set</label>
        <input id="h" inputmode="numeric" maxlength="2" aria-label="Hours" value="00" />
        <input id="m" inputmode="numeric" maxlength="2" aria-label="Minutes" value="00" />
        <input id="s" inputmode="numeric" maxlength="2" aria-label="Seconds" value="00" />
        <button type="submit">Go</button>
      </form>
      <button id="full" type="button">Full screen</button>
    </div>
    <script src="../scripts/clock.js"></script>
  </body>
</html>
